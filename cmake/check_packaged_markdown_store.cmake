# Fails when the built app's markdown-store differs from markdown-store/bundled.
# Only bundled product skills ship; personal top-level store entries must not.
if(NOT IS_DIRECTORY "${PACKAGED_STORE}")
  message(FATAL_ERROR "Packaged Markdown Store not found: ${PACKAGED_STORE}. Build universal_agent_manager first.")
endif()
file(GLOB_RECURSE _packaged RELATIVE "${PACKAGED_STORE}" LIST_DIRECTORIES false "${PACKAGED_STORE}/*")
file(GLOB_RECURSE _allowed RELATIVE "${SOURCE_ROOT}/markdown-store" LIST_DIRECTORIES false "${SOURCE_ROOT}/markdown-store/bundled/*")
if(NOT _allowed)
  message(FATAL_ERROR "No bundled skills found under ${SOURCE_ROOT}/markdown-store/bundled.")
endif()
set(_unexpected ${_packaged})
list(REMOVE_ITEM _unexpected ${_allowed})
set(_missing ${_allowed})
if(_packaged)
  list(REMOVE_ITEM _missing ${_packaged})
endif()
if(_unexpected OR _missing)
  list(JOIN _unexpected "\n  " _unexpected_text)
  list(JOIN _missing "\n  " _missing_text)
  message(FATAL_ERROR "Packaged Markdown Store must match markdown-store/bundled exactly.\nUnexpected:\n  ${_unexpected_text}\nMissing:\n  ${_missing_text}")
endif()
list(LENGTH _packaged _count)
message(STATUS "Packaged Markdown Store holds only the ${_count} bundled entries.")
