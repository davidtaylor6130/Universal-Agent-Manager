  WORKSPACE --> WORKTREE["Isolated Git worktree + turn checkpoints"]

  CHATS --> WRITER["Atomic replace + sync + validated recovery"]
  SETTINGS --> WRITER
  FOLDERS --> WRITER
  RUNS --> WRITER

  APP --> LIMITS["Bounded queues, output, inactivity, deadlines, retries"]
  APP --> PLATFORM["Platform services"]
