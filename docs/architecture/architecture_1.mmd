flowchart LR
  UI["React UI"] --> CEF["Restricted uam:// CEF bridge"]
  CEF --> APP["Application services + AppState"]
  APP --> REGISTRY["Provider runtime registry"]

  REGISTRY --> GEMINI["Gemini CLI"]
  REGISTRY --> CODEX["Codex CLI"]
  REGISTRY --> CLAUDE["Claude Code CLI"]
  REGISTRY --> OPENCODE["OpenCode CLI"]
  REGISTRY --> COPILOT["GitHub Copilot CLI"]

  REGISTRY --> STRUCTURED["Structured sessions\nGemini/OpenCode/Copilot ACP\nCodex app-server\nClaude stream-json"]
  REGISTRY --> TERMINAL["xterm.js terminal fallback"]
  STRUCTURED --> MIDDLEMAN["UAM permission middleman\nAlways ask / YOLO / AI review\nPlan hard read-only ceiling"]
  MIDDLEMAN --> UI

  STRUCTURED --> PROCESS["Platform process service"]
  TERMINAL --> PTY["Platform PTY service"]
  PROCESS --> CONTAINMENT["Owned process-tree containment"]
  PTY --> CONTAINMENT

  APP --> AGENTS["Provider-neutral UAM agents"]
  AGENTS --> SCHEDULER["Bounded durable agent-run scheduler"]
  SCHEDULER --> REGISTRY
  APP --> WORKERS["Isolated bounded text workers"]
  WORKERS --> PROCESS
