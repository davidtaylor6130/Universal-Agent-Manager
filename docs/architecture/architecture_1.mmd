flowchart LR
  UI["React UI"] --> CEF["Restricted uam:// CEF bridge"]
  CEF --> APP["Application services + AppState"]
  APP --> REGISTRY["Provider runtime registry"]

  REGISTRY --> GEMINI["Gemini CLI"]
  REGISTRY --> CODEX["Codex CLI"]
  REGISTRY --> CLAUDE["Claude Code CLI"]
  REGISTRY --> OPENCODE["OpenCode CLI"]
  REGISTRY --> COPILOT["GitHub Copilot CLI"]
  REGISTRY --> ANTIGRAVITY["Antigravity CLI: stream JSON + native terminal"]

  REGISTRY --> STRUCTURED["Structured sessions: ACP, app-server, stream JSON"]
  REGISTRY --> TERMINAL["Native CLI in xterm.js"]
  STRUCTURED --> POLICY["Native and UAM permission decisions: Default, Accept Edits, AI Review, YOLO"]
  POLICY --> UI

  APP --> SETUP["Shared instructions, skills, agents and MCP setup"]
  SETUP --> REGISTRY
  APP --> EXECUTION["Local execution or verified SSH helper"]
  STRUCTURED --> EXECUTION
  TERMINAL --> EXECUTION
  EXECUTION --> CONTAINMENT["Owned process and PTY lifecycles"]

  APP --> AGENTS["Provider-neutral UAM agents and bounded goal work"]
  AGENTS --> REGISTRY
  APP --> WORKERS["Bounded worker processes"]
  WORKERS --> EXECUTION

  PHONE["Optional phone browser"] --> COMPANION["Restricted authenticated companion interface"]
  COMPANION --> APP
  STRUCTURED --> COMPUTER["Selected local UAM or provider computer-use route"]
