<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into CEF's bootstrap.exe (shipped as universal_agent_manager.exe), whose own manifest already declares
     Windows 10 compatibility. Lets Win32 and MSVC std::filesystem/fstream in universal_agent_manager.dll accept paths
     past MAX_PATH when Windows long paths are enabled. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
